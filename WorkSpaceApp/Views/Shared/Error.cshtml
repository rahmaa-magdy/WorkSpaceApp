@{
    ViewData["Title"] = "Something went wrong";
}

<div class="error-page">

    <div class="error-box">

        <div class="page-eyebrow">
            Error
        </div>

        <h1>Something went wrong.</h1>

        <p>
            We couldn't complete your request.
            Please try again.
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-primary">
            Back to Dashboard
        </a>

    </div>

</div>
