<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WorkSpaceApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WorkSpaceApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom">

            <div class="container">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    WorkSpace
                </a>

                <div class="navbar-nav ms-auto">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">
                            Dashboard
                        </a>

                        <a class="nav-link"
                           asp-controller="Workspace"
                           asp-action="Index">
                            Workspaces
                        </a>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="d-inline">

                            <button type="submit"
                                    class="nav-link border-0 bg-transparent">
                                Logout
                            </button>

                        </form>
                    }
                    else
                    {
                        <a class="nav-link"
                           asp-controller="Account"
                           asp-action="Login">
                            Login
                        </a>

                        <a class="nav-link"
                           asp-controller="Account"
                           asp-action="Register">
                            Register
                        </a>
                    }

                </div>

            </div>

        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - WorkSpaceApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
