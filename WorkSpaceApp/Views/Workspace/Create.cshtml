@model WorkSpaceApp.Models.Workspace

@{
    ViewData["Title"] = "New Workspace";
}

<div class="form-page">

    <div class="form-header">
        <h1>New Workspace</h1>
        <p>Create a workspace for your team.</p>
    </div>

    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>

        <div class="form-group">
            <label asp-for="Name"></label>

            <input asp-for="Name"
                   class="form-control"
                   placeholder="e.g. Graduation Project" />

            <span asp-validation-for="Name"
                  class="text-danger">
            </span>
        </div>

        <div class="form-group">
            <label asp-for="Description"></label>

            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"
                      placeholder="What is this workspace for?">
            </textarea>

            <span asp-validation-for="Description"
                  class="text-danger">
            </span>
        </div>

        <div class="form-actions">

            <a asp-action="Index"
               class="btn btn-light">
                Cancel
            </a>

            <button type="submit"
                    class="btn btn-dark">
                Create Workspace
            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}