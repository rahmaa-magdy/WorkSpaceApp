@model WorkSpaceApp.ViewModels.TaskEditViewModel

@{
    ViewData["Title"] = "Edit Task";

    var members = ViewBag.Members
        as List<WorkSpaceApp.Models.WorkspaceMember>;
}

<div class="form-page">

    <div class="form-header">

        <div class="page-eyebrow">
            @ViewBag.ProjectName
        </div>

        <h1>Edit Task</h1>

        <p>
            Update the task details and progress.
        </p>

    </div>

    <form asp-action="Edit" method="post">

        <input asp-for="Id" type="hidden" />
        <input asp-for="ProjectId" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>

        <div class="form-group">

            <label asp-for="Title"></label>

            <input asp-for="Title"
                   class="form-control" />

            <span asp-validation-for="Title"
                  class="text-danger">
            </span>

        </div>

        <div class="form-group">

            <label asp-for="Description"></label>

            <textarea asp-for="Description"
                      class="form-control"
                      rows="5">
            </textarea>

            <span asp-validation-for="Description"
                  class="text-danger">
            </span>

        </div>

        <div class="form-row">

            <div class="form-group">

                <label asp-for="Status"></label>

                <select asp-for="Status"
                        asp-items="Html.GetEnumSelectList<
                                                    WorkSpaceApp.Models.TaskStatus>()"
                        class="form-control">
                </select>

            </div>

            <div class="form-group">

                <label asp-for="Priority"></label>

                <select asp-for="Priority"
                        asp-items="Html.GetEnumSelectList<
                                                    WorkSpaceApp.Models.TaskPriority>()"
                        class="form-control">
                </select>

            </div>

        </div>

        <div class="form-row">

            <div class="form-group">

                <label asp-for="DueDate"></label>

                <input asp-for="DueDate"
                       type="date"
                       class="form-control" />

            </div>

            <div class="form-group">

                <label asp-for="AssignedToUserId">
                    Assigned to
                </label>

                <select asp-for="AssignedToUserId"
                        class="form-control">

                    <option value="">
                        Unassigned
                    </option>

                    @if (members != null)
                    {
                        foreach (var member in members)
                        {
                            <option value="@member.UserId">
                                @member.User.FullName
                            </option>
                        }
                    }

                </select>

            </div>

        </div>

        <div class="form-actions">

            <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-light">
                Cancel
            </a>

            <button type="submit"
                    class="btn btn-dark">
                Save Changes
            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}