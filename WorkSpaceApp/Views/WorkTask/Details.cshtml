@model WorkSpaceApp.Models.WorkTask

@{
    ViewData["Title"] = Model.Title;
}

<div class="task-details">

    <div class="workspace-back">

        <a asp-controller="Project"
           asp-action="Details"
           asp-route-id="@Model.ProjectId">
            ← @Model.Project.Name
        </a>

    </div>

    <div class="task-details-header">

        <div>

            <div class="page-eyebrow">
                Task
            </div>

            <h1>@Model.Title</h1>

            <div class="task-meta">

                <span>@Model.Status</span>

                <span>@Model.Priority</span>

                @if (Model.DueDate.HasValue)
                {
                    <span>
                        Due
                        @Model.DueDate.Value
                        .ToString("dd MMM yyyy")
                    </span>
                }

            </div>

        </div>

        <div class="task-actions">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-outline-dark">
                Edit
            </a>

            <form asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post"
                  onsubmit="return confirm('Delete this task?');">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-light text-danger">
                    Delete
                </button>

            </form>

        </div>

    </div>

    <div class="task-content">

        <section class="task-description">

            <h2>Description</h2>

            @if (string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="muted">
                    No description added.
                </p>
            }
            else
            {
                <p>
                    @Model.Description
                </p>
            }

        </section>

        <aside class="task-sidebar">

            <div class="detail-row">

                <span>Assigned to</span>

                <strong>
                    @(Model.AssignedToUser?.FullName
                                        ?? "Unassigned")
                </strong>

            </div>

            <div class="detail-row">

                <span>Status</span>

                <strong>@Model.Status</strong>

            </div>

            <div class="detail-row">

                <span>Priority</span>

                <strong>@Model.Priority</strong>

            </div>

            <div class="detail-row">

                <span>Created</span>

                <strong>
                    @Model.CreatedAt.ToString("dd MMM yyyy")
                </strong>

            </div>

        </aside>

    </div>

    <section class="comments-section">

        <div class="section-heading">

            <div>
                <h2>Comments</h2>
                <p>Discuss this task with your team.</p>
            </div>

        </div>

        <form asp-controller="Comment"
              asp-action="Create"
              method="post"
              class="comment-form">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="WorkTaskId"
                   value="@Model.Id" />

            <textarea name="Content"
                      class="form-control"
                      rows="3"
                      maxlength="1000"
                      placeholder="Write a comment..."></textarea>

            <div class="comment-form-actions">

                <button type="submit"
                        class="btn btn-dark">
                    Add Comment
                </button>

            </div>

        </form>

        @if (!Model.Comments.Any())
        {
            <div class="empty-state">

                <h3>No comments yet</h3>

                <p>
                    Start a conversation about this task.
                </p>

            </div>
        }
        else
        {
            <div class="comment-list">

                @foreach (var comment in Model.Comments
                            .OrderBy(c => c.CreatedAt))
                {
                    <div class="comment-item">

                        <div class="comment-header">

                            <strong>
                                @comment.User.FullName
                            </strong>

                            <span>
                                @comment.CreatedAt
                                .ToLocalTime()
                                .ToString(
                                "dd MMM yyyy, HH:mm")
                            </span>

                        </div>

                        <p>
                            @comment.Content
                        </p>

                        @if (comment.UserId ==
                                        User.FindFirst(
                                        System.Security.Claims.ClaimTypes.NameIdentifier
                                        )?.Value)
                        {
                            <form asp-controller="Comment"
                                  asp-action="Delete"
                                  asp-route-id="@comment.Id"
                                  method="post"
                                  class="comment-delete-form"
                                  onsubmit="return confirm('Delete this comment?');">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="comment-delete">
                                    Delete
                                </button>

                            </form>
                        }

                    </div>
                }

            </div>
        }

    </section>

</div>