@model WorkSpaceApp.ViewModels.ProjectEditViewModel

@{
    ViewData["Title"] = "Edit Project";
}

<div class="form-page">

    <div class="form-header">

        <div class="page-eyebrow">
            Project
        </div>

        <h1>Edit Project</h1>

        <p>
            Update the project information.
        </p>

    </div>

    <form asp-action="Edit" method="post">

        <input asp-for="Id" type="hidden" />
        <input asp-for="WorkspaceId" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>

        <div class="form-group">

            <label asp-for="Name"></label>

            <input asp-for="Name"
                   class="form-control" />

            <span asp-validation-for="Name"
                  class="text-danger">
            </span>

        </div>

        <div class="form-group">

            <label asp-for="Description"></label>

            <textarea asp-for="Description"
                      class="form-control"
                      rows="5">
            </textarea>

            <span asp-validation-for="Description"
                  class="text-danger">
            </span>

        </div>

        <div class="form-row">

            <div class="form-group">

                <label asp-for="Status"></label>

                <select asp-for="Status"
                        asp-items="Html.GetEnumSelectList<
                                                    WorkSpaceApp.Models.ProjectStatus>()"
                        class="form-control">
                </select>

            </div>

            <div class="form-group">

                <label asp-for="Deadline"></label>

                <input asp-for="Deadline"
                       type="date"
                       class="form-control" />

            </div>

        </div>

        <div class="form-actions">

            <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-light">
                Cancel
            </a>

            <button type="submit"
                    class="btn btn-dark">
                Save Changes
            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}