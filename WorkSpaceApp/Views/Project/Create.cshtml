@model WorkSpaceApp.ViewModels.ProjectCreateViewModel

@{
    ViewData["Title"] = "New Project";
}

<div class="form-page">

    <div class="form-header">

        <div class="page-eyebrow">
            @ViewBag.WorkspaceName
        </div>

        <h1>New Project</h1>

        <p>
            Add a project to this workspace.
        </p>

    </div>

    <form asp-action="Create" method="post">

        <input asp-for="WorkspaceId" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>

        <div class="form-group">

            <label asp-for="Name"></label>

            <input asp-for="Name"
                   class="form-control"
                   placeholder="e.g. Website redesign" />

            <span asp-validation-for="Name"
                  class="text-danger">
            </span>

        </div>

        <div class="form-group">

            <label asp-for="Description"></label>

            <textarea asp-for="Description"
                      class="form-control"
                      rows="5"
                      placeholder="What are you working on?">
            </textarea>

            <span asp-validation-for="Description"
                  class="text-danger">
            </span>

        </div>

        <div class="form-group">

            <label asp-for="Deadline"></label>

            <input asp-for="Deadline"
                   class="form-control" />

            <span asp-validation-for="Deadline"
                  class="text-danger">
            </span>

        </div>

        <div class="form-group">

            <label asp-for="Status"></label>

            <select asp-for="Status"
                    asp-items="Html.GetEnumSelectList<
                                            WorkSpaceApp.Models.ProjectStatus>()"
                    class="form-control">
            </select>

        </div>

        <div class="form-actions">

            <a asp-controller="Workspace"
               asp-action="Details"
               asp-route-id="@Model.WorkspaceId"
               class="btn btn-light">
                Cancel
            </a>

            <button type="submit"
                    class="btn btn-dark">
                Create Project
            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}